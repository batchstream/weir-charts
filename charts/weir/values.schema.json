{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resources",
    "podAnnotations",
    "nodeSelector",
    "affinity",
    "imagePullSecrets",
    "tolerations",
    "topologySpreadConstraints",
    "extraVolumes",
    "extraVolumeMounts",
    "nameOverride",
    "fullnameOverride",
    "replicaCount",
    "terminationGracePeriodSeconds",
    "containerPort",
    "image",
    "config",
    "service",
    "peer",
    "diagnostics",
    "podDisruptionBudget",
    "strategy",
    "networkPolicy"
  ],
  "properties": {
    "resources": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "affinity": {
      "type": "object"
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "tolerations": {
      "type": "array"
    },
    "topologySpreadConstraints": {
      "type": "array"
    },
    "extraVolumes": {
      "type": "array"
    },
    "extraVolumeMounts": {
      "type": "array"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 10,
      "maximum": 300
    },
    "containerPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[0-9a-f]{64})?$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingSecret",
        "key",
        "revision"
      ],
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "key": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*$"
        },
        "revision": {
          "type": "string"
        },
        "data": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port",
        "annotations"
      ],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "peer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "port"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port"
      ],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "maxUnavailable"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxUnavailable": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "Recreate",
            "RollingUpdate"
          ]
        },
        "rollingUpdate": {
          "type": "object"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "ingress",
        "egress",
        "dns"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingress": {
          "type": "array"
        },
        "egress": {
          "type": "array"
        },
        "dns": {
          "type": "object"
        }
      }
    }
  }
}
