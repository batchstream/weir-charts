{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resources",
    "podAnnotations",
    "nodeSelector",
    "affinity",
    "imagePullSecrets",
    "tolerations",
    "topologySpreadConstraints",
    "extraVolumes",
    "extraVolumeMounts",
    "nameOverride",
    "fullnameOverride",
    "replicaCount",
    "minReadySeconds",
    "progressDeadlineSeconds",
    "terminationGracePeriodSeconds",
    "preStopDelaySeconds",
    "image",
    "service",
    "diagnosticsPort",
    "podDisruptionBudget",
    "strategy",
    "networkPolicy",
    "metrics",
    "stores",
    "autoscaling",
    "shutdownTimeoutSeconds"
  ],
  "properties": {
    "resources": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "affinity": {
      "type": "object"
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "tolerations": {
      "type": "array"
    },
    "topologySpreadConstraints": {
      "type": "array"
    },
    "extraVolumes": {
      "type": "array"
    },
    "extraVolumeMounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "mountPath",
          "readOnly"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "mountPath": {
            "type": "string"
          },
          "readOnly": {
            "const": true
          }
        }
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "minReadySeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483646
    },
    "progressDeadlineSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "preStopDelaySeconds": {
      "type": "integer",
      "minimum": 0
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "digest",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[0-9a-f]{64})?$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port"
      ],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "maxUnavailable"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxUnavailable": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "Recreate",
            "RollingUpdate"
          ]
        },
        "rollingUpdate": {
          "type": "object"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "ingress",
        "egress",
        "dns"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingress": {
          "type": "array"
        },
        "egress": {
          "type": "array"
        },
        "dns": {
          "type": "object"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "annotations",
        "ingress",
        "serviceMonitor"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object"
        },
        "ingress": {
          "type": "array"
        },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "labels",
            "interval",
            "scrapeTimeout"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "labels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "interval": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
            },
            "scrapeTimeout": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
            }
          }
        }
      }
    },
    "stores": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z](?:[a-z0-9]|-[a-z0-9])*$"
          },
          "mongodb": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "uri"
            ],
            "properties": {
              "uri": {
                "type": "string"
              }
            }
          },
          "search": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string"
              }
            }
          },
          "authentication": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "username_file",
              "password_file"
            ],
            "properties": {
              "username_file": {
                "type": "string",
                "minLength": 1
              },
              "password_file": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "tls": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ca_file"
            ],
            "properties": {
              "ca_file": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "batching": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "max_operations": {
                "type": "integer",
                "minimum": 0
              },
              "max_bytes": {
                "type": "string"
              },
              "max_wait": {
                "type": "string"
              },
              "max_in_flight": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "oneOf": [
          {
            "required": [
              "mongodb"
            ],
            "not": {
              "required": [
                "search"
              ]
            }
          },
          {
            "required": [
              "search"
            ],
            "not": {
              "required": [
                "mongodb"
              ]
            }
          }
        ]
      }
    },
    "shutdownTimeoutSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036,
      "description": "Whole seconds within the Go duration range; drives Weir's shutdown_timeout and the Pod grace period."
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "minReplicaCount",
        "maxReplicaCount",
        "pollingInterval",
        "cooldownPeriod",
        "triggers",
        "scaleDown"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "pollingInterval": {
          "type": "integer",
          "minimum": 1
        },
        "cooldownPeriod": {
          "type": "integer",
          "minimum": 0
        },
        "triggers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "metadata"
            ],
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "metricType": {
                "enum": [
                  "AverageValue",
                  "Value",
                  "Utilization"
                ]
              },
              "useCachedMetrics": {
                "type": "boolean"
              },
              "metadata": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "string"
                }
              },
              "authenticationRef": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "enum": [
                      "TriggerAuthentication",
                      "ClusterTriggerAuthentication"
                    ]
                  }
                }
              }
            }
          }
        },
        "scaleDown": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stabilizationWindowSeconds",
            "policies"
          ],
          "properties": {
            "stabilizationWindowSeconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3600
            },
            "selectPolicy": {
              "enum": [
                "Max",
                "Min",
                "Disabled"
              ]
            },
            "policies": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "value",
                  "periodSeconds"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "Pods",
                      "Percent"
                    ]
                  },
                  "value": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "periodSeconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1800
                  }
                }
              }
            }
          }
        }
      }
    },
    "diagnosticsPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    }
  }
}
