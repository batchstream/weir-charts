{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resources",
    "podAnnotations",
    "nodeSelector",
    "affinity",
    "imagePullSecrets",
    "tolerations",
    "topologySpreadConstraints",
    "extraVolumes",
    "extraVolumeMounts",
    "nameOverride",
    "fullnameOverride",
    "replicaCount",
    "minReadySeconds",
    "progressDeadlineSeconds",
    "terminationGracePeriodSeconds",
    "preStopDelaySeconds",
    "image",
    "service",
    "diagnosticsPort",
    "probeTimeoutMilliseconds",
    "podDisruptionBudget",
    "strategy",
    "networkPolicy",
    "metrics",
    "stores",
    "storesSecret",
    "storesRevision",
    "clusterDomain",
    "nodeConfig",
    "mesh",
    "autoscaling",
    "lifecycle"
  ],
  "properties": {
    "resources": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "affinity": {
      "type": "object"
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "tolerations": {
      "type": "array"
    },
    "topologySpreadConstraints": {
      "type": "array"
    },
    "extraVolumes": {
      "type": "array"
    },
    "extraVolumeMounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "mountPath",
          "readOnly"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "mountPath": {
            "type": "string"
          },
          "readOnly": {
            "const": true
          }
        }
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "minReadySeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483646
    },
    "progressDeadlineSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "preStopDelaySeconds": {
      "type": "integer",
      "minimum": 0
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "digest",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[0-9a-f]{64})?$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port",
        "annotations"
      ],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "maxUnavailable"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxUnavailable": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "Recreate",
            "RollingUpdate"
          ]
        },
        "rollingUpdate": {
          "type": "object"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "ingress",
        "egress",
        "dns"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingress": {
          "type": "array"
        },
        "egress": {
          "type": "array"
        },
        "dns": {
          "type": "object"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "annotations",
        "ingress",
        "serviceMonitor"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object"
        },
        "ingress": {
          "type": "array"
        },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "labels",
            "interval",
            "scrapeTimeout"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "labels": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "interval": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
            },
            "scrapeTimeout": {
              "type": "string",
              "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
            }
          }
        }
      }
    },
    "stores": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "backend"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z](?:[a-z0-9]|-[a-z0-9])*$"
          },
          "backend": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mongodb": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "uri"
                ],
                "properties": {
                  "uri": {
                    "type": "string"
                  },
                  "max_connecting": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "metadata_cache_entries": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "retry_attempts": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "retry_backoff": {
                    "type": "string"
                  }
                }
              },
              "search": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string"
                  },
                  "retry_attempts": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "idle_timeout": {
                    "type": "string"
                  }
                }
              },
              "authentication": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "username_file": {
                    "type": "string"
                  },
                  "password_file": {
                    "type": "string"
                  }
                }
              },
              "tls": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "ca_file": {
                    "type": "string"
                  }
                }
              },
              "connect_timeout": {
                "type": "string"
              },
              "max_exchange_bytes": {
                "type": "string"
              }
            },
            "oneOf": [
              {
                "required": [
                  "mongodb"
                ],
                "not": {
                  "required": [
                    "search"
                  ]
                }
              },
              {
                "required": [
                  "search"
                ],
                "not": {
                  "required": [
                    "mongodb"
                  ]
                }
              }
            ]
          },
          "queue": {
            "type": "object"
          },
          "batching": {
            "type": "object"
          }
        }
      }
    },
    "storesSecret": {
      "type": "string"
    },
    "storesRevision": {
      "type": "string"
    },
    "clusterDomain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
    },
    "nodeConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lua": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_instructions": {
              "type": "integer",
              "minimum": 0
            },
            "max_call_depth": {
              "type": "integer",
              "minimum": 0
            },
            "max_stack_slots": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "transport": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_pending_records": {
              "type": "integer",
              "minimum": 0
            },
            "timeouts": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "handshake": {
                  "type": "string",
                  "minLength": 1
                },
                "idle": {
                  "type": "string",
                  "minLength": 1
                },
                "stall": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "keepalive": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "interval": {
                  "type": "string",
                  "minLength": 1
                },
                "timeout": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "overload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "memory": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "high_watermark": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "low_watermark": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "sample_interval": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "discovery": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lease": {
              "type": "string",
              "minLength": 1
            },
            "sync_interval": {
              "type": "string",
              "minLength": 1
            },
            "sync_timeout": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "diagnostics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "timeout": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "mesh": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "name",
        "port",
        "seeds"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "seeds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "minReplicaCount",
        "maxReplicaCount",
        "pollingInterval",
        "cooldownPeriod",
        "triggers",
        "scaleDown"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicaCount": {
          "type": "integer",
          "minimum": 1
        },
        "pollingInterval": {
          "type": "integer",
          "minimum": 1
        },
        "cooldownPeriod": {
          "type": "integer",
          "minimum": 0
        },
        "triggers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "metadata"
            ],
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "metricType": {
                "enum": [
                  "AverageValue",
                  "Value",
                  "Utilization"
                ]
              },
              "useCachedMetrics": {
                "type": "boolean"
              },
              "metadata": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "string"
                }
              },
              "authenticationRef": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "enum": [
                      "TriggerAuthentication",
                      "ClusterTriggerAuthentication"
                    ]
                  }
                }
              }
            }
          }
        },
        "scaleDown": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stabilizationWindowSeconds",
            "policies"
          ],
          "properties": {
            "stabilizationWindowSeconds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3600
            },
            "selectPolicy": {
              "enum": [
                "Max",
                "Min",
                "Disabled"
              ]
            },
            "policies": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "value",
                  "periodSeconds"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "Pods",
                      "Percent"
                    ]
                  },
                  "value": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "periodSeconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1800
                  }
                }
              }
            }
          }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startupTimeoutSeconds",
        "shutdownTimeoutSeconds",
        "cleanupTimeoutSeconds"
      ],
      "properties": {
        "startupTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036,
          "description": "Whole seconds within the Go duration range; generated Weir and Pod budgets share this value."
        },
        "shutdownTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036,
          "description": "Whole seconds within the Go duration range; generated Weir and Pod budgets share this value."
        },
        "cleanupTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036,
          "description": "Whole seconds within the Go duration range; generated Weir and Pod budgets share this value."
        }
      }
    },
    "diagnosticsPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "probeTimeoutMilliseconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483646000,
      "description": "Probe CLI deadline in milliseconds; kubelet timeoutSeconds is rounded up plus one second and must fit int32."
    }
  }
}
